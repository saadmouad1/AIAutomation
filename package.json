{
  "name": "aurivo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && cross-env NODE_ENV=test node --test dist-tests/tests/**/*.test.js",
    "test:watch": "tsc -p tsconfig.test.json -w & cross-env NODE_ENV=test node --test --watch dist-tests/tests/**/*.test.js",
    "test:coverage": "tsc -p tsconfig.test.json && cross-env NODE_ENV=test node --test --experimental-test-coverage dist-tests/tests/**/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
